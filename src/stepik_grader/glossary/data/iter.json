    "examples": [
      "class CountUp:",
      "def __init__(self, start, stop):",
      "self.current = start",
      "self.stop = stop",
      "def __iter__(self):",
      "return self",
      "def __next__(self):",
      "if self.current >= self.stop:",
      "raise StopIteration",
      "val = self.current",
      "self.current += 1",
      "return val",
      "for x in CountUp(1, 4):",
      "print(x, end=' ')  # → 1 2 3",
      "class Squares:",
      "def __init__(self, n):",
      "self.i = 0; self.n = n",
      "def __iter__(self): return self",
      "def __next__(self):",
      "if self.i >= self.n: raise StopIteration",
      "val = self.i**2",
      "self.i += 1",
      "return val",
      "print(list(Squares(5)))  # → [0,1,4,9,16]",
      "# Итератор — одноразовый!",
      "it = iter([1,2,3])",
