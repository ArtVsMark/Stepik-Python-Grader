      "iter",
      "next"
    ],
    "tags": [
      "iter"
    ],
    "examples": [
      "it = iter([1,2,3])",
      "print(next(it))  # → 1",
      "print(next(it))  # → 2",
      "print(next(it))  # → 3",
      "print(next(it, 'end'))  # → end",
      "# iter со sentinel",
      "import io",
      "f = io.StringIO('line1\\nline2\\n')",
      "for line in iter(f.readline, ''):",
