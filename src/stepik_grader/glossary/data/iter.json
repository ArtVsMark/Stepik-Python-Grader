      "print(list(it))  # → [] исчерпан!",
      "class FibIter:",
      "def __init__(self, max_n):",
      "self.a, self.b = 0, 1",
      "self.max_n = max_n",
      "def __iter__(self): return self",
      "def __next__(self):",
      "if self.a > self.max_n: raise StopIteration",
      "val = self.a",
      "self.a, self.b = self.b, self.a+self.b",
      "return val",
