    "subcat": "перебор",
    "aliases": [],
    "keywords": [],
    "tags": [
      "mapset"
    ],
    "examples": [
      "d = {'a': 1, 'b': 2, 'c': 3}",
      "print(list(d.keys()))",
      "# → ['a', 'b', 'c']",
      "print(list(d.values()))",
      "# → [1, 2, 3]",
      "print(list(d.items()))",
      "# → [('a', 1), ('b', 2), ('c', 3)]",
      "for k, v in d.items():",
      "print(k, '->', v)",
      "# → a -> 1 / b -> 2 / c -> 3",
      "print('a' in d.keys())",
      "# → True",
      "print(1 in d.values())",
      "# → True",
      "for k in d:",
      "print(k)",
