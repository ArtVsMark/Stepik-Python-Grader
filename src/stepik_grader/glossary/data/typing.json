    "subcat": "протокол",
    "aliases": [],
    "keywords": [],
    "tags": [
      "typing"
    ],
    "examples": [
      "from typing import Protocol",
      "class Drawable(Protocol):",
      "def draw(self) -> None: ...",
      "class Circle:",
      "def draw(self) -> None: print('O')",
      "class Square:",
      "def draw(self) -> None: print('[]')",
