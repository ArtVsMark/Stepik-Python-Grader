  {
    "id": "issubset-issuperset-isdisjoint",
    "title": "issubset() / issuperset() / isdisjoint()",
    "kind": "function",
    "summary": {
      "ru": "issubset() — проверяет, является ли подмножеством. issuperset() — надмножеством. isdisjoint() — нет общих элементов.",
      "en": ""
    },
    "body": {
      "ru": "",
      "en": ""
    },
    "syntax": "a.issubset(b)  |  a.issuperset(b)  |  a.isdisjoint(b)  |  a <= b  |  a >= b",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-issubset-issuperset-isdisjoint",
    "docs_url": "https://docs.python.org/3/library/stdtypes.html",
    "version": "",
    "section": "Множества (set)",
    "subcat": "проверка",
    "aliases": [],
    "keywords": [],
    "tags": [
      "mapset"
    ],
    "examples": [
      "a = {1, 2}",
      "b = {1, 2, 3, 4}",
      "print(a.issubset(b))",
      "# → True",
      "print(a <= b)",
      "# → True",
      "print(b.issuperset(a))",
      "# → True",
      "print(a.issubset(a))",
      "# → True (подмножество самого себя)",
      "print(a < b)",
      "# → True (строгое подмножество)",
      "print({1, 2}.isdisjoint({3, 4}))",
      "# → True",
      "print({1, 2}.isdisjoint({2, 3}))",
      "# → False (есть 2)"
    ],
    "related": [],
