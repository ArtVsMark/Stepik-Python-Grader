      "en": ""
    },
    "body": {
      "ru": "",
      "en": ""
    },
    "syntax": "map(func, iterable)  |  filter(func, iterable)",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-map-filter-для-списков",
    "docs_url": "https://docs.python.org/3/library/stdtypes.html",
    "version": "",
    "section": "Списки (list)",
    "subcat": "функциональное",
    "aliases": [],
    "keywords": [],
    "tags": [
      "seq"
    ],
    "examples": [
      "print(list(map(str, [1, 2, 3])))",
      "# → ['1', '2', '3']",
      "print(list(map(lambda x: x**2, [1, 2, 3, 4])))",
      "# → [1, 4, 9, 16]",
      "print(list(filter(lambda x: x > 2, [1, 2, 3, 4])))",
      "# → [3, 4]",
      "print(list(filter(None, [0, 1, '', 'a', None, 2])))",
      "# → [1, 'a', 2] (filter(None, ...) — отбор истинных)",
      "a = [1, 2, 3]",
      "b = [10, 20, 30]",
      "print(list(map(lambda x, y: x+y, a, b)))",
      "# → [11, 22, 33]",
      "words = ['hello', '', 'world', '']",
      "print(list(filter(lambda w: w, words)))",
      "# → ['hello', 'world']",
      "nums = [1, 2, 3, 4, 5, 6]",
      "evens_sq = list(map(lambda x: x**2, filter(lambda x: x%2==0, nums)))",
      "print(evens_sq)",
      "# → [4, 16, 36]"
    ],
