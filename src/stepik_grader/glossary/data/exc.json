  {
    "id": "try-except",
    "title": "try / except",
    "kind": "exception",
    "summary": "Блок try содержит код, который может вызвать исключение. except перехватывает его. else — если исключения не было. finally — всегда.",
    "body": "",
    "syntax": "try:\n    ...\nexcept ErrorType:\n    ...",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-try-except",
    "docs_url": "https://docs.python.org/3/library/exceptions.html",
    "version": "",
    "section": "Исключения",
    "subcat": "обработка",
    "aliases": [],
    "keywords": [],
    "tags": [
      "exc"
    ],
    "examples": [
      "try:",
      "x = 1 / 0",
      "except ZeroDivisionError:",
      "print('division by zero')  # → division by zero",
      "try:",
      "int('abc')",
      "except ValueError as e:",
      "print(e)  # → invalid literal for int()...",
      "# Несколько except",
      "try:",
      "lst = [1,2,3]",
      "print(lst[10])",
      "except IndexError:",
      "print('index error')  # → index error",
      "except Exception as e:",
      "print('other:', e)",
      "# else — если исключений не было",
      "try:",
      "result = 10 / 2",
      "except ZeroDivisionError:",
      "print('error')",
      "else:",
