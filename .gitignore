# Спутник-файл межпроцессной блокировки (atomic_io.file_lock): создаётся при
# первой записи настроек и намеренно не удаляется, иначе гонка возвращается.
.grader_settings.json.lock

# issue #1262: сведения о сборке считаются при сборке колеса
