      "en": ""
    },
    "body": {
      "ru": "",
      "en": ""
    },
    "syntax": "d.copy()  import copy; copy.deepcopy(d)",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-copy-deepcopy-словаря",
    "docs_url": "https://docs.python.org/3/library/stdtypes.html",
    "version": "",
    "section": "Словари (dict)",
    "subcat": "копирование",
    "aliases": [],
    "keywords": [],
    "tags": [
      "mapset"
    ],
    "examples": [
      "import copy",
      "orig = {\"a\": [1,2], \"b\": 3}",
      "shallow = orig.copy(); shallow[\"a\"].append(99)",
      "print(orig)     # → {'a': [1, 2, 99], 'b': 3}  (список общий)",
      "orig2 = {\"a\": [1,2], \"b\": 3}",
      "deep = copy.deepcopy(orig2); deep[\"a\"].append(99)",
      "print(orig2)    # → {'a': [1, 2], 'b': 3}        (оригинал цел)",
