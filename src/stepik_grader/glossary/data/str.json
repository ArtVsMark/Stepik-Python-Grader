    "subcat": "выравнивание",
    "aliases": [],
    "keywords": [],
    "tags": [
      "str"
    ],
    "examples": [
      "print('hi'.center(10))",
      "# → '    hi    '",
      "print('hi'.center(10, '-'))",
      "# → '----hi----'",
