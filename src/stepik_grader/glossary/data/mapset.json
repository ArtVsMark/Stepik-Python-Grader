      "en": ""
    },
    "body": {
      "ru": "",
      "en": ""
    },
    "syntax": "item in s  |  item not in s",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-in-not-in-для-множеств-o-1",
    "docs_url": "https://docs.python.org/3/library/stdtypes.html",
    "version": "",
    "section": "Множества (set)",
    "subcat": "поиск",
    "aliases": [],
    "keywords": [],
    "tags": [
      "mapset"
    ],
    "examples": [
      "s = {1, 2, 3, 4, 5}",
      "print(3 in s)",
      "# → True",
      "print(6 in s)",
      "# → False",
      "print(6 not in s)",
      "# → True",
      "big = set(range(10**6))",
      "print(999999 in big)",
      "# → True (мгновенно, O(1))",
      "banned = {'spam', 'ads', 'junk'}",
      "msg = 'spam email'",
      "print(any(w in banned for w in msg.split()))",
      "# → True"
    ],
