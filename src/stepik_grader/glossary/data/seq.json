      "ru": "enumerate() возвращает пары (индекс, элемент). start= задаёт начальный индекс.",
      "en": ""
    },
    "body": {
      "ru": "",
      "en": ""
    },
    "syntax": "enumerate(lst[, start=0])",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-enumerate-со-списком",
    "docs_url": "https://docs.python.org/3/library/stdtypes.html",
    "version": "",
    "section": "Списки (list)",
    "subcat": "итерация",
    "aliases": [],
    "keywords": [],
    "tags": [
      "seq"
    ],
    "examples": [
      "lst = ['a', 'b', 'c']",
      "for i, v in enumerate(lst):",
      "print(i, v)",
      "# → 0 a / 1 b / 2 c",
      "for i, v in enumerate(lst, start=1):",
      "print(i, v)",
      "# → 1 a / 2 b / 3 c",
      "indexed = list(enumerate(['x', 'y', 'z']))",
      "print(indexed)",
      "# → [(0, 'x'), (1, 'y'), (2, 'z')]",
      "words = ['zero', 'one', 'two']",
      "d = {i: w for i, w in enumerate(words)}",
      "print(d)",
      "# → {0: 'zero', 1: 'one', 2: 'two'}",
      "lst2 = [10, 20, 30]",
      "max_i = max(enumerate(lst2), key=lambda x: x[1])",
      "print(max_i)",
      "# → (2, 30)"
    ],
