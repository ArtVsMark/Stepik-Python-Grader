  {
    "id": "del-d-key-pop-popitem-clear",
    "title": "del d[key] / pop() / popitem() / clear()",
    "kind": "function",
    "summary": {
      "ru": "del удаляет ключ (KeyError если нет). pop() удаляет и возвращает. popitem() удаляет последнюю пару. clear() очищает весь словарь.",
      "en": ""
    },
    "body": {
      "ru": "",
      "en": ""
    },
    "syntax": "del d[key]  |  d.pop(key[, default])  |  d.popitem()  |  d.clear()",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-del-d-key-pop-popitem-clear",
    "docs_url": "https://docs.python.org/3/library/stdtypes.html",
    "version": "",
    "section": "Словари (dict)",
    "subcat": "доступ",
    "aliases": [],
    "keywords": [],
    "tags": [
      "mapset"
    ],
    "examples": [
      "d = {'a': 1, 'b': 2, 'c': 3}",
      "del d['a']",
      "print(d)",
      "# → {'b': 2, 'c': 3}",
      "val = d.pop('b')",
      "print(val, d)",
      "# → 2 {'c': 3}",
      "print(d.pop('x', 'missing'))",
      "# → 'missing' (default)",
      "d2 = {'a': 1, 'b': 2, 'c': 3}",
      "k, v = d2.popitem()",
      "print(k, v)",
      "# → 'c' 3 (последняя пара)",
      "d3 = {'a': 1, 'b': 2}",
      "d3.clear()",
      "print(d3)",
      "# → {}",
      "try:",
      "del d['z']",
      "except KeyError as e:",
      "print(e)",
      "# → 'z'",
      "try:",
      "{}.popitem()",
      "except KeyError as e:",
      "print(e)",
      "# → 'popitem(): dictionary is empty'"
    ],
    "related": [],
    "related_errors": []
  },
