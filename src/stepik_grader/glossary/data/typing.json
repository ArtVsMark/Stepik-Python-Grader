    },
    "syntax": "from typing import Protocol\nclass MyProtocol(Protocol):\n    def method(self) -> type: ...",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-protocol",
    "docs_url": "https://docs.python.org/3/library/typing.html",
