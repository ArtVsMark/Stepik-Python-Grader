  {
    "id": "f-строки",
    "title": "f-строки",
    "kind": "term",
    "summary": {
      "ru": "f-строки (f'...') — форматированные строковые литералы. Выражения в {} вычисляются во время выполнения.",
      "en": ""
    },
    "body": {
      "ru": "",
      "en": ""
    },
    "syntax": "f'{expr}'  |  f'{val:.2f}'  |  f'{val!r}'",
    "status": "ready",
    "url": "https://artvsmark.github.io/Glossary-Python/#e-f-строки",
    "docs_url": "https://docs.python.org/3/library/stdtypes.html",
    "version": "",
    "section": "Строки (str)",
    "subcat": "форматирование",
    "aliases": [],
    "keywords": [],
    "tags": [
      "str"
    ],
    "examples": [
      "name = 'Alice'",
      "print(f'Hello, {name}!')",
      "# → 'Hello, Alice!'",
      "x = 3.14159",
      "print(f'{x:.2f}')",
      "# → '3.14'",
      "print(f'{2 ** 10}')",
      "# → '1024'",
      "n = 42",
      "print(f'{n:>10d}')",
      "# → '        42'",
      "print(f'{n:010d}')",
      "# → '0000000042'",
      "s = 'hello'",
      "print(f'{s!r}')",
      "# → \"'hello'\"",
      "width = 10",
      "print(f'{\"center\":{width}^}')",
      "# → '  center  '",
      "val = 1234567.89",
      "print(f'{val:,.2f}')",
      "# → '1,234,567.89'"
    ],
    "related": [],
    "related_errors": []
  },
